{
  "name": "joeyddong-blog",
  "version": "0.1.0",
  "private": true,
  "description": "JoeyDDong 的 Hexo 博客，基于 Icarus 定制",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "scripts": {
    "dev": "hexo server --ip 127.0.0.1",
    "build": "hexo generate --bail",
    "clean": "hexo clean",
    "check": "node --test tests/*.test.cjs",
    "verify": "pnpm build && node tools/verify-build.cjs"
  },
  "dependencies": {
    "bulma-stylus": "0.8.0",
    "deepmerge": "4.3.1",
    "hexo": "8.1.2",
    "hexo-component-inferno": "3.1.2",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-category": "2.0.0",
    "hexo-generator-index": "4.0.0",
    "hexo-generator-tag": "2.0.0",
    "hexo-log": "4.1.0",
    "hexo-pagination": "3.0.0",
    "hexo-renderer-inferno": "1.0.2",
    "hexo-renderer-markdown-it": "7.1.1",
    "hexo-renderer-stylus": "3.0.1",
    "hexo-server": "3.0.0",
    "hexo-theme-icarus": "6.1.1",
    "hexo-util": "3.3.0",
    "inferno": "8.2.3",
    "inferno-create-element": "8.2.3",
    "katex": "0.19.0",
    "markdown-it-texmath": "1.0.0",
    "moment": "2.30.1",
    "semver": "7.7.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "babel-plugin-inferno": "6.8.0"
  }
}
